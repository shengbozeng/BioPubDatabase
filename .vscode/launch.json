{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}", // 👈 设置当前工作目录为项目根目录
            "env": {
                "PYTHONPATH": "${workspaceFolder}" // 👈 添加项目根目录到模块查找路径
            }
        },
        {
            "name": "SDFIndex: build (main.py + args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/nih/pubchem/index/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "build",
                "--root",
                "Z:\\pubchem_unzipped_data\\conformer",
                "--index",
                "Z:\\pubchem_unzipped_dataconformer",
                "--map-size",
                "1099511627776",
            ]
        },
        {
            "name": "SDFIndex: get compound (main.py + args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/nih/pubchem/index/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "get-compound",
                "--root",
                "Z:\\pubchem_unzipped_data\\compound",
                "--index",
                "Z:\\pubchem_unzipped_data\\compound",
                "--cid",
                "361276"
            ]
        },
        {
            "name": "SDFIndex: batch get compound (main.py + args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/nih/pubchem/index/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "batch-get-compound",
                "--root",
                "Z:\\pubchem_unzipped_data\\compound",
                "--index",
                "Z:\\pubchem_unzipped_data\\compound",
                "--cid_start",
                "1",
                "--cid_end",
                "9999"
            ]
        },
        {
            "name": "SDFIndex: get conformer (main.py + args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/nih/pubchem/data/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "get-conformer",
                "--root",
                "Z:\\pubchem_unzipped_data\\conformer",
                "--index",
                "Z:\\pubchem_unzipped_data\\conformer",
                "--confid",
                "361276"
            ]
        },
        {
            "name": "SDFIndex: list conformers (main.py + args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/nih/pubchem/data/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "list-conformers",
                "--root",
                "Z:\\pubchem_unzipped_data\\conformer",
                "--index",
                "Z:\\pubchem_unzipped_data\\conformer",
                "--cid_start",
                "1",
                "--cid_end",
                "9999999"
            ]
        },
        {
            "name": "SDFIndex: batch query data (main.py + args)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/nih/pubchem/data/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "batch-query-data",
                "--compound_root",
                "Z:\\pubchem_unzipped_data\\compound",
                "--compound_index",
                "Z:\\pubchem_unzipped_data\\compound",
                "--cid_start",
                "1",
                "--cid_end",
                "9999999",
                "--conformer_root",
                "Z:\\pubchem_unzipped_data\\conformer",
                "--conformer_index",
                "Z:\\pubchem_unzipped_data\\conformer",
                "--conformer_limit",
                "1"
            ]
        },
    ]
}